{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revistacliche",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // everything else is a static file and never wakes the Worker
    "run_worker_first": ["/", "/feed/", "/feed/podcast/", "/wp-content/uploads/*", "/exp/media/*"]
  },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "revistacliche-media" }]
}
